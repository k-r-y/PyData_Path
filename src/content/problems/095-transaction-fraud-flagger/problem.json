  },
  "compare": "exact",
  "tests": {
    "visible": [
      {
        "label": "Flags high amount, burst velocity, and impossible geo jump",
        "args": [
          [
            {
              "tx_id": "t1",
              "account": "A",
              "ts": 100,
              "amount": 50,
              "country": "US"
            },
            {
              "tx_id": "t2",
              "account": "A",
              "ts": 120,
              "amount": 6000,
              "country": "US"
            },
            {
              "tx_id": "t3",
              "account": "A",
              "ts": 130,
              "amount": 20,
              "country": "US"
            },
            {
              "tx_id": "t4",
              "account": "A",
              "ts": 140,
              "amount": 25,
              "country": "FR"
            }
          ]
        ],
        "expected": [
          {
            "tx_id": "t2",
            "reasons": [
              "HIGH_AMOUNT"
            ]
          },
          {
            "tx_id": "t4",
            "reasons": [
              "GEO_IMPOSSIBLE",
              "VELOCITY"
            ]
          }
        ]
      },
      {
        "label": "Accounts tracked independently across overlapping timestamps",
        "args": [
          [
            {
              "tx_id": "x1",
              "account": "A",
              "ts": 10,
              "amount": 10,
              "country": "US"
            },
            {
              "tx_id": "x2",
              "account": "B",
              "ts": 11,
              "amount": 10,
              "country": "UK"
            },
            {
              "tx_id": "x3",
              "account": "A",
              "ts": 12,
              "amount": 10,
              "country": "US"
            },
            {
              "tx_id": "x4",
              "account": "B",
              "ts": 13,
              "amount": 10,
              "country": "UK"
            }
          ]
        ],
        "expected": []
      }
    ],
    "hidden": [
      {
        "label": "Exactly 3 transactions in 60s allowed; 4th triggers VELOCITY",
        "args": [
          [
            {
              "tx_id": "1",
              "account": "A",
