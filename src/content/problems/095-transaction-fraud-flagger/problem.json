            },
            {
              "tx_id": "4",
              "account": "A",
              "ts": 161,
              "amount": 10,
              "country": "SG"
            }
          ]
        ],
        "expected": []
      },
      {
        "label": "Inclusive 60s window boundary triggers VELOCITY on 4th at t+60",
        "args": [
          [
            {
              "tx_id": "1",
              "account": "A",
              "ts": 100,
              "amount": 10,
              "country": "SG"
            },
            {
              "tx_id": "2",
              "account": "A",
              "ts": 110,
              "amount": 10,
              "country": "SG"
            },
            {
              "tx_id": "3",
              "account": "A",
              "ts": 120,
              "amount": 10,
              "country": "SG"
            },
            {
              "tx_id": "4",
              "account": "A",
              "ts": 160,
              "amount": 10,
              "country": "SG"
            }
          ]
        ],
        "expected": [
          {
            "tx_id": "4",
            "reasons": [
              "VELOCITY"
            ]
          }
        ]
      },
      {
        "label": "Country jump at exact 300s triggers; 301s does not",
        "args": [
          [
            {
              "tx_id": "1",
              "account": "A",
              "ts": 0,
              "amount": 50,
              "country": "US"
            },
            {
              "tx_id": "2",
              "account": "A",
              "ts": 300,
              "amount": 50,
              "country": "JP"
            },
            {
              "tx_id": "3",
              "account": "A",
              "ts": 601,
              "amount": 50,
              "country": "CA"
            }
          ]
        ],
        "expected": [
          {
            "tx_id": "2",
            "reasons": [
              "GEO_IMPOSSIBLE"
            ]
          }
        ]
      },
      {
        "label": "Amount exactly 5000.0 is clean; 5000.01 flags HIGH_AMOUNT",
        "args": [
          [
            {
              "tx_id": "ok",
              "account": "A",
              "ts": 1,
              "amount": 5000,
              "country": "US"
            },
            {
              "tx_id": "bad",
              "account": "A",
              "ts": 2,
              "amount": 5000.01,
              "country": "US"
            }
          ]
        ],
        "expected": [
          {
            "tx_id": "bad",
            "reasons": [
              "HIGH_AMOUNT"
            ]
          }
        ]
      },
      {
        "label": "Linear O(n) sliding window performance on 12,000 single-account events",
        "argsExpr": "([{\"tx_id\": f\"t{i}\", \"account\": \"HOT\", \"ts\": i * 20, \"amount\": 100.0, \"country\": \"US\"} for i in range(12000)],)",
        "expected": [
          {
            "tx_id": "t3",
            "reasons": [
              "VELOCITY"
            ]
          }
        ],
        "expectedExpr": "[{\"tx_id\": f\"t{i}\", \"reasons\": [\"VELOCITY\"]} for i in range(3, 12000)]",
        "timeLimitMs": 1800,
        "isPerformance": true
      }
    ]
  },
  "hints": [
    "Maintain a separate `collections.deque` of recent timestamps and last `(ts, country)` pair per account.",
    "Evict timestamps strictly older than `ts - 60` (`while q and q[0] < ts - 60: q.popleft()`) BEFORE appending the new transaction.",
    "Append current `ts`; if `len(q) > 3`, record `\"VELOCITY\"`. Always sort the reasons list for any flagged transaction."
  ],
