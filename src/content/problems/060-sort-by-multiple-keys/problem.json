  "hints": [
    "Use sorted(rows, key=lambda r: (r[\"category\"], -r[\"stock\"], r[\"sku\"])).",
    "Never mutate rows with rows.sort() in place.",
    "Pseudocode:\n  return sorted(rows, key=lambda item: (item[\"category\"], -item[\"stock\"], item[\"sku\"]))"
  ],
